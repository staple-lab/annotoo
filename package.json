{
  "name": "annotoo-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm build && pnpm --filter example-vite-react dev",
    "dev:static": "pnpm --filter @staplelab/annotoo build && pnpm --filter example-static dev",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "e2e": "pnpm build && playwright test",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "site": "pnpm build && pnpm --filter site dev",
    "site:build": "pnpm build && pnpm --filter site build"
  },
  "devDependencies": {
    "@changesets/cli": "2.27.11",
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.10.5",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.19.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
