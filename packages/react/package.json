{
  "name": "@staplelab/annotoo-react",
  "version": "0.1.0",
  "description": "React component for Annotoo: Figma-style annotations on your prototype that ship with your build.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "keywords": ["react", "annotations", "notes", "prototype", "feedback", "figma"],
  "repository": { "type": "git", "url": "git+https://github.com/staple-lab/annotoo.git", "directory": "packages/react" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@staplelab/annotoo": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@testing-library/react": "16.1.0",
    "@types/react": "18.3.18",
    "jsdom": "25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "8.3.5",
    "vitest": "2.1.8"
  }
}
