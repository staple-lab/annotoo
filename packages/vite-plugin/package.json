{
  "name": "@staplelab/vite-plugin-annotoo",
  "version": "0.2.0",
  "description": "Git-backed discussion threads for Annotoo in Vite development, with optional read-only build snapshots.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "vite-plugin",
    "annotoo",
    "annotations",
    "prototype",
    "collaboration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/staple-lab/annotoo.git",
    "directory": "packages/vite-plugin"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "tsup": "8.3.5",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
