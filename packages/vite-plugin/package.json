{
  "name": "@staplelab/vite-plugin-annotoo",
  "version": "0.1.0",
  "description": "Vite dev-server plugin for Annotoo: saves your prototype annotations straight into a JSON file in your repo.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "keywords": ["vite-plugin", "notate", "annotations", "prototype"],
  "repository": { "type": "git", "url": "git+https://github.com/staple-lab/annotoo.git", "directory": "packages/vite-plugin" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "tsup": "8.3.5",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
