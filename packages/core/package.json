{
  "name": "@staplelab/annotoo",
  "version": "0.1.0",
  "description": "Figma-style annotations for code prototypes. Annotate your UI, ship the notes with your build, and anyone opening it sees them in place.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./dist/annotoo.js", "./src/self-src.ts", "./src/iife.ts"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/annotoo.js",
  "jsdelivr": "./dist/annotoo.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./annotoo.js": "./dist/annotoo.js",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "keywords": ["annotations", "notes", "handoff", "prototype", "review", "figma", "widget"],
  "repository": { "type": "git", "url": "git+https://github.com/staple-lab/annotoo.git", "directory": "packages/core" },
  "scripts": {
    "build": "tsup && node scripts/inline-self.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "jsdom": "25.0.1",
    "tsup": "8.3.5",
    "vitest": "2.1.8"
  }
}
