{
  "name": "@staplelab/annotoo",
  "version": "0.5.1",
  "description": "Figma-style annotations for code prototypes. Annotate your UI, ship the notes with your build, and anyone opening it sees them in place.",
  "license": "MIT",
  "homepage": "https://annotoo.staplelab.com/",
  "type": "module",
  "sideEffects": [
    "./dist/annotoo.js",
    "./src/self-src.ts",
    "./src/iife.ts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/annotoo.js",
  "jsdelivr": "./dist/annotoo.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./annotoo.js": "./dist/annotoo.js",
    "./package.json": "./package.json",
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "annotations",
    "notes",
    "handoff",
    "prototype",
    "review",
    "figma",
    "widget"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/staple-lab/annotoo.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/inline-self.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "jsdom": "25.0.1",
    "tsup": "8.3.5",
    "vitest": "2.1.8",
    "vite": "6.0.7"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
